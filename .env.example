# Copy this file to .env and fill in OPENROUTER_API_KEY before `docker compose up`.
# Verify OPENROUTER_MODEL against https://openrouter.ai/models before first run --
# model slugs on OpenRouter drift; this plan was written against anthropic/claude-sonnet-4.5.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# low|medium|high -- verified live: this model returns reasoning_details with
# "effort", not "max_tokens" (despite some docs suggesting Anthropic models
# use a token-budget style; that works for deepseek-r1, not this model).
REASONING_EFFORT=high

POSTGRES_USER=appuser
POSTGRES_PASSWORD=changeme
POSTGRES_DB=chatdb
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# "v3" (default) uses LangGraph's experimental event-streaming API; switch to
# "v2" if it ever misbehaves on a future langgraph version.
STREAMING_API_VERSION=v3
